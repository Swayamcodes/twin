{
  "name": "@twin-cli/cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Run commands in a full project copy, inspect receipts, and apply or discard changes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "bin": {
    "twin": "./dist/index.js"
  },
  "dependencies": {
    "@twin-cli/core": "workspace:*",
    "@inquirer/select": "5.2.5"
  },
  "files": ["dist/*.js", "dist/*.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=24.2.0" },
  "repository": { "type": "git", "url": "git+https://github.com/Swayamcodes/twin.git", "directory": "packages/cli" },
  "homepage": "https://github.com/Swayamcodes/twin#readme",
  "bugs": { "url": "https://github.com/Swayamcodes/twin/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --filter @twin-cli/core build && pnpm run build"
  }
}
