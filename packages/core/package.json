{
  "name": "@twin-cli/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Clone-and-run project isolation and bounded change receipts for coding commands.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/*.js", "dist/*.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=24.2.0" },
  "repository": { "type": "git", "url": "git+https://github.com/Swayamcodes/twin.git", "directory": "packages/core" },
  "homepage": "https://github.com/Swayamcodes/twin#readme",
  "bugs": { "url": "https://github.com/Swayamcodes/twin/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "tsc -p tsconfig.json --types node",
    "prepack": "pnpm run build"
  }
}
